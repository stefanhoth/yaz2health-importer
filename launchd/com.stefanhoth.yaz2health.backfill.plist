<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stefanhoth.yaz2health.backfill</string>

    <!-- sync --lookback 3: covers today + 2 previous days -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/stefan/go/bin/yaz2health</string>
        <string>sync</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/stefan/go/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <!-- once daily at 07:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/stefan/Library/Logs/yaz2health.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/stefan/Library/Logs/yaz2health.log</string>
</dict>
</plist>
